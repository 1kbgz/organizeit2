import builtins
from datetime import datetime
from typing import Any

class Directory:
    def __init__(self, path: builtins.str) -> None: ...
    def __hash__(self) -> int: ...
    def __lt__(self, other: Directory) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __len__(self) -> int: ...
    def str(self) -> builtins.str: ...
    def exists(self) -> bool: ...
    def as_posix(self) -> builtins.str: ...
    @property
    def name(self) -> builtins.str: ...
    @property
    def suffix(self) -> builtins.str: ...
    @property
    def stem(self) -> builtins.str: ...
    @property
    def parts(self) -> builtins.list[builtins.str]: ...
    @property
    def parent(self) -> Directory: ...
    def modified(self) -> datetime: ...
    def resolve(self) -> Any: ...
    def match(self, pattern: builtins.str, *, name_only: bool = True, invert: bool = False) -> bool: ...
    def all_match(self, pattern: builtins.str, *, name_only: bool = True, invert: bool = False) -> builtins.list[Any]: ...
    def rematch(self, re: builtins.str, *, name_only: bool = True, invert: bool = False) -> bool: ...
    def all_rematch(self, re: builtins.str, *, name_only: bool = True, invert: bool = False) -> builtins.list[Any]: ...
    def link(self, other: Directory, *, soft: bool = True) -> None: ...
    def unlink(self) -> None: ...
    def rm(self) -> None: ...
    def ls(self) -> builtins.list[Any]: ...
    def list(self) -> builtins.list[builtins.str]: ...
    def recurse(self) -> builtins.list[Any]: ...
    def size(self, block_size: int = 4096) -> int: ...
    def __truediv__(self, other: builtins.str) -> Any: ...

class File:
    def __init__(self, path: builtins.str) -> None: ...
    def __hash__(self) -> int: ...
    def __lt__(self, other: File) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def str(self) -> builtins.str: ...
    def exists(self) -> bool: ...
    def as_posix(self) -> builtins.str: ...
    @property
    def name(self) -> builtins.str: ...
    @property
    def suffix(self) -> builtins.str: ...
    @property
    def stem(self) -> builtins.str: ...
    @property
    def parts(self) -> builtins.list[builtins.str]: ...
    @property
    def parent(self) -> Directory: ...
    def modified(self) -> datetime: ...
    def resolve(self) -> Any: ...
    def match(self, pattern: builtins.str, *, name_only: bool = True, invert: bool = False) -> bool: ...
    def rematch(self, re: builtins.str, *, name_only: bool = True, invert: bool = False) -> bool: ...
    def link(self, other: File, *, soft: bool = True) -> None: ...
    def unlink(self) -> None: ...
    def rm(self) -> None: ...
    def size(self, block_size: int = 4096) -> int: ...
    def __truediv__(self, other: builtins.str) -> Any: ...

class OrganizeIt:
    def __init__(self) -> None: ...
    def expand(self, directory: builtins.str) -> Directory: ...

def Path(path: builtins.str) -> File | Directory: ...
